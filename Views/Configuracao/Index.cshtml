@model VisaoDeAguia.Models.ConfiguracaoRobo

@{
    ViewData["Title"] = "Telegram";
}

<div class="container py-5">

    <div class="mb-5">

        <span class="secao-label">
            VISÃO DE ÁGUIA
        </span>

        <h1 class="mt-2">
            Configuração do Telegram
        </h1>

        <p class="text-secondary">
            Configure o grupo que receberá os sinais
            enviados pelo Visão de Águia.
        </p>

    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["ErroTelegram"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErroTelegram"]
        </div>
    }

    <div class="painel-analise mb-4">

        <div class="painel-topo">

            <span>
                TELEGRAM
            </span>

            @if (Model.TelegramAtivo &&
                 !string.IsNullOrWhiteSpace(Model.TelegramChatId))
            {
                <span class="telegram-status telegram-status-ativo">
                    ● CONFIGURADO
                </span>
            }
            else
            {
                <span class="telegram-status telegram-status-pendente">
                    ● AGUARDANDO CONFIGURAÇÃO
                </span>
            }

        </div>

        <form asp-controller="Configuracao"
              asp-action="Index"
              method="post">

            <div class="mt-4 mb-4">

                <label asp-for="TelegramBotToken"
                       class="form-label">
                    Token do Bot
                </label>

                <input asp-for="TelegramBotToken"
                       type="password"
                       class="form-control"
                       autocomplete="off"
                       placeholder="Cole aqui o token fornecido pelo BotFather" />

                <div class="form-text text-secondary mt-2">
                    Se você já salvou o token anteriormente,
                    pode deixar este campo vazio.
                </div>

            </div>

            <input asp-for="TelegramChatId"
                   type="hidden" />

            @if (!string.IsNullOrWhiteSpace(Model.TelegramChatId))
            {
                <div class="telegram-grupo">

                    <div class="telegram-grupo-icone">
                        ✓
                    </div>

                    <div>

                        <span>
                            GRUPO LOCALIZADO
                        </span>

                        <strong>
                            Chat ID: @Model.TelegramChatId
                        </strong>

                    </div>

                </div>
            }

            <div class="d-flex flex-wrap gap-3 mt-4">

                <button type="submit"
                        class="btn-visao-principal border-0">
                    Salvar Token
                </button>

            </div>

        </form>

        <div class="telegram-separador"></div>

        <div class="telegram-instrucoes">

            <span class="secao-label">
                COMO CONFIGURAR
            </span>

            <ol>
                <li>
                    Crie ou utilize seu bot no Telegram e copie o token.
                </li>

                <li>
                    Cole o token acima e clique em
                    <strong>Salvar Token</strong>.
                </li>

                <li>
                    Adicione o bot ao grupo que receberá os sinais.
                </li>

                <li>
                    Envie qualquer mensagem dentro desse grupo.
                </li>

                <li>
                    Clique em
                    <strong>Buscar Grupo do Telegram</strong>.
                </li>
            </ol>

        </div>

        <div class="d-flex flex-wrap gap-3 mt-4">

            <form asp-controller="Configuracao"
                  asp-action="BuscarGrupo"
                  method="post">

                <button type="submit"
                        class="btn-visao-secundario">
                    Buscar Grupo do Telegram
                </button>

            </form>

            <form asp-controller="Configuracao"
                  asp-action="TestarTelegram"
                  method="post">

                <button type="submit"
                        class="btn-visao-principal border-0">
                    Enviar Mensagem de Teste
                </button>

            </form>

        </div>

    </div>

</div>

<style>

    .telegram-status {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .telegram-status-ativo {
        color: #00e696;
    }

    .telegram-status-pendente {
        color: #ffc107;
    }

    .telegram-grupo {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding: 14px 16px;
        background: rgba(0, 230, 150, 0.06);
        border: 1px solid rgba(0, 230, 150, 0.25);
        border-radius: 8px;
    }

    .telegram-grupo-icone {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #00e696;
        color: #06140f;
        font-size: 18px;
        font-weight: 900;
    }

    .telegram-grupo span {
        display: block;
        margin-bottom: 3px;
        color: #00e696;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .telegram-grupo strong {
        color: #dce7ed;
        font-size: 13px;
    }

    .telegram-separador {
        height: 1px;
        margin: 28px 0;
        background: #1b303b;
    }

    .telegram-instrucoes ol {
        margin: 15px 0 0;
        padding-left: 20px;
        color: #9aabb4;
    }

    .telegram-instrucoes li {
        margin-bottom: 8px;
        padding-left: 4px;
        font-size: 13px;
        line-height: 1.6;
    }

    .telegram-instrucoes strong {
        color: #dce7ed;
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}