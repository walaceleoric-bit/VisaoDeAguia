<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Visão de Águia</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/VisaoDeAguia.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header class="cabecalho-visao">

        <nav class="navbar navbar-expand-lg navbar-dark">

            <div class="container">

                <button class="navbar-toggler ms-auto"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="menuPrincipal">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Início
                            </a>

                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Analise"
                                   asp-action="Index">
                                    Analisar
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Historico"
                                   asp-action="Index">
                                    Histórico
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Configuracao"
                                   asp-action="Index">
                                    Configuração
                                </a>

                            </li>

                            <li class="nav-item ms-lg-3">

                                <form asp-controller="Conta"
                                      asp-action="Sair"
                                      method="post">

                                    <button type="submit"
                                            class="btn-sair">
                                        Sair
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">

                                <a class="btn-login-menu"
                                   asp-controller="Conta"
                                   asp-action="Login">
                                    Login
                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <main role="main">

        @RenderBody()

    </main>

    <footer class="rodape-visao">

        <div class="container">

            <img src="~/images/logo-wlc.png"
                 asp-append-version="true"
                 alt="Visão de Águia"
                 class="rodape-logo" />

            <div class="rodape-desenvolvido">
                Desenvolvido por <strong>WLC Sistemas</strong>
            </div>

            <div class="rodape-contato">
                WhatsApp: (27) 98843-3016
            </div>

            <div class="rodape-aviso">
                Plataforma de assistência à análise de mercado.
                As informações apresentadas não representam garantia
                de resultado ou recomendação de investimento.
            </div>

            <div class="rodape-copy">
                © @DateTime.Now.Year Visão de Águia. Todos os direitos reservados.
            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>