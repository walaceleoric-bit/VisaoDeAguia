@model VisaoDeAguia.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";

    var cadastroSucesso =
        TempData["CadastroSucesso"] as string;
}

<section class="login-visao">

    <div class="container">

        <div class="login-container">

            <div class="login-card">

                <div class="login-topo">

                    <img src="~/images/logo-wlc.png"
                         alt="Visão de Águia"
                         class="login-logo" />

                    <h1>ACESSAR O SISTEMA</h1>

                    <p>
                        Entre com sua conta para acessar o
                        Visão de Águia.
                    </p>

                </div>

                @if (!string.IsNullOrWhiteSpace(cadastroSucesso))
                {
                    <div class="cadastro-sucesso">

                        <div class="cadastro-sucesso-icone">
                            ✓
                        </div>

                        <div class="cadastro-sucesso-titulo">
                            CADASTRO REALIZADO
                        </div>

                        <div class="cadastro-sucesso-texto">
                            @cadastroSucesso
                        </div>

                        <a href="https://wa.me/5527988433016?text=Ol%C3%A1%21%20Acabei%20de%20fazer%20meu%20cadastro%20no%20Vis%C3%A3o%20de%20%C3%81guia%20e%20preciso%20da%20libera%C3%A7%C3%A3o%20do%20meu%20acesso."
                           target="_blank"
                           rel="noopener noreferrer"
                           class="cadastro-whatsapp">

                            Avisar pelo WhatsApp

                        </a>

                    </div>
                }

                <form asp-controller="Conta"
                      asp-action="Login"
                      asp-route-returnUrl="@ViewData["ReturnUrl"]"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="login-validacao"></div>

                    <div class="login-campo">

                        <label asp-for="Email">
                            E-mail
                        </label>

                        <input asp-for="Email"
                               class="login-input"
                               autocomplete="email"
                               placeholder="Digite seu e-mail" />

                        <span asp-validation-for="Email"
                              class="login-erro"></span>

                    </div>

                    <div class="login-campo">

                        <label asp-for="Senha">
                            Senha
                        </label>

                        <input asp-for="Senha"
                               class="login-input"
                               autocomplete="current-password"
                               placeholder="Digite sua senha" />

                        <span asp-validation-for="Senha"
                              class="login-erro"></span>

                    </div>

                    <div class="login-opcoes">

                        <div class="form-check">

                            <input asp-for="LembrarMe"
                                   class="form-check-input" />

                            <label asp-for="LembrarMe"
                                   class="form-check-label">
                                Lembrar de mim
                            </label>

                        </div>

                    </div>

                    <button type="submit"
                            class="login-botao">
                        Entrar
                    </button>

                </form>

                <div class="login-cadastro">

                    <span>
                        Ainda não possui uma conta?
                    </span>

                    <a asp-controller="Conta"
                       asp-action="Cadastro">
                        Criar conta
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<style>

    .cadastro-sucesso {
        margin-bottom: 24px;
        padding: 18px;
        text-align: center;
        background: rgba(0, 230, 150, 0.08);
        border: 1px solid rgba(0, 230, 150, 0.35);
        border-radius: 10px;
    }

    .cadastro-sucesso-icone {
        width: 38px;
        height: 38px;
        margin: 0 auto 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #00e696;
        color: #07120e;
        font-size: 22px;
        font-weight: 900;
    }

    .cadastro-sucesso-titulo {
        margin-bottom: 6px;
        color: #00e696;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .cadastro-sucesso-texto {
        margin-bottom: 14px;
        color: #b8c8d1;
        font-size: 13px;
        line-height: 1.5;
    }

    .cadastro-whatsapp {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        background: #25d366;
        border-radius: 7px;
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .cadastro-whatsapp:hover {
        color: #ffffff;
        filter: brightness(1.08);
        transform: translateY(-1px);
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}