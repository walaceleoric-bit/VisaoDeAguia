@{
    ViewData["Title"] = "Início";
}

<section class="hero-visao">

    <video class="hero-video"
           autoplay
           muted
           loop
           playsinline>
        <source src="~/videos/fundotec.mp4" type="video/mp4" />
    </video>

    <div class="hero-overlay"></div>

    <div class="container hero-conteudo">

        <img src="~/images/logo-wlc.png"
             asp-append-version="true"
             alt="Visão de Águia"
             class="hero-logo" />

        <div class="hero-badge">
            ASSISTENTE INTELIGENTE DE MERCADO
        </div>

        <h2>
            Enxergue o contexto antes de tomar sua decisão.
        </h2>

        <p class="hero-descricao">
            Análise inteligente do EUR/USD utilizando múltiplos períodos
            gráficos para identificar tendência, estrutura, pullback e
            confirmação de possíveis cenários.
        </p>

        <div class="hero-acoes">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Analise"
                   asp-action="Index"
                   class="btn-visao-principal">
                    Analisar Mercado
                </a>

                <a asp-controller="Configuracao"
                   asp-action="Index"
                   class="btn-visao-secundario">
                    Configurar Robô
                </a>
            }
            else
            {
                <a asp-controller="Conta"
                   asp-action="Login"
                   class="btn-visao-principal">
                    Entrar no Sistema
                </a>

                <a asp-controller="Conta"
                   asp-action="Cadastro"
                   class="btn-visao-secundario">
                    Criar Conta
                </a>
            }

        </div>

        <div class="hero-status">
            <span></span>
            Monitoramento inteligente do EUR/USD
        </div>

    </div>

</section>


<section class="secao-mercados">

    <div class="container">

        <div class="titulo-secao">

            <span>
                ANÁLISE INTELIGENTE
            </span>

            <h2>
                Uma visão completa antes de considerar um sinal
            </h2>

            <p>
                O Visão de Águia acompanha o EUR/USD em diferentes
                períodos gráficos e reúne informações importantes
                antes de classificar um cenário.
            </p>

        </div>


        <div class="row g-4">

            <!-- MULTI-TIMEFRAME -->
            <div class="col-lg-4 col-md-6">

                <div class="mercado-card">

                    <div class="mercado-icone">
                        MTF
                    </div>

                    <span class="mercado-status">
                        ANÁLISE MULTI-TIMEFRAME
                    </span>

                    <h3>
                        Do contexto à entrada
                    </h3>

                    <p>
                        Diferentes períodos são analisados em conjunto
                        para entender o movimento do mercado antes de
                        avaliar uma possível oportunidade.
                    </p>

                    <ul>
                        <li>Tendência em 2H e 1H</li>
                        <li>Estrutura em 30M</li>
                        <li>Pullback em 15M</li>
                        <li>Confirmação em 5M</li>
                    </ul>

                </div>

            </div>


            <!-- FILTROS -->
            <div class="col-lg-4 col-md-6">

                <div class="mercado-card">

                    <div class="mercado-icone">
                        100
                    </div>

                    <span class="mercado-status">
                        FILTRO DE CENÁRIOS
                    </span>

                    <h3>
                        Sinais mais seletivos
                    </h3>

                    <p>
                        O sistema reúne diferentes confirmações antes
                        de classificar a força do cenário encontrado.
                    </p>

                    <ul>
                        <li>Tendência e estrutura</li>
                        <li>Suporte e resistência</li>
                        <li>Pullback e confirmação</li>
                        <li>Pontuação de 0 a 100</li>
                    </ul>

                </div>

            </div>


            <!-- ROBÔ -->
            <div class="col-lg-4 col-md-6">

                <div class="mercado-card">

                    <div class="mercado-icone">
                        BOT
                    </div>

                    <span class="mercado-status">
                        ROBÔ AUTOMÁTICO
                    </span>

                    <h3>
                        Monitoramento no seu horário
                    </h3>

                    <p>
                        Escolha o período em que deseja que o robô
                        acompanhe o mercado e receba automaticamente
                        os sinais que passarem pelos filtros.
                    </p>

                    <ul>
                        <li>Horário configurável</li>
                        <li>Até 2h30 de análise por dia</li>
                        <li>Monitoramento automático</li>
                        <li>Envio de sinais pelo Telegram</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="secao-inteligencia">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <span class="secao-label">
                    COMO FUNCIONA
                </span>

                <h2>
                    O mercado se movimenta.<br />
                    O Visão de Águia observa.
                </h2>

                <p>
                    O sistema acompanha o EUR/USD utilizando uma
                    estratégia multi-timeframe. Cada período gráfico
                    possui uma função dentro da análise.
                </p>

                <p>
                    Tendência, estrutura, suporte, resistência,
                    pullback e comportamento das velas são combinados
                    para determinar a força do cenário antes que um
                    sinal seja considerado.
                </p>

            </div>


            <div class="col-lg-6">

                <div class="painel-analise">

                    <div class="painel-topo">

                        <span>
                            EXEMPLO DE MONITORAMENTO
                        </span>

                        <span class="online">
                            ● ONLINE
                        </span>

                    </div>


                    <div class="analise-linha">

                        <span>
                            Tendência 2H
                        </span>

                        <strong>
                            Confirmada
                        </strong>

                    </div>


                    <div class="analise-linha">

                        <span>
                            Tendência 1H
                        </span>

                        <strong>
                            Alinhada
                        </strong>

                    </div>


                    <div class="analise-linha">

                        <span>
                            Estrutura 30M
                        </span>

                        <strong>
                            Favorável
                        </strong>

                    </div>


                    <div class="analise-linha">

                        <span>
                            Pullback 15M
                        </span>

                        <strong>
                            Confirmado
                        </strong>

                    </div>


                    <div class="analise-linha">

                        <span>
                            Confirmação 5M
                        </span>

                        <strong>
                            Aguardando
                        </strong>

                    </div>


                    <div class="score-exemplo">

                        <span>
                            FORÇA DO CENÁRIO
                        </span>

                        <div>
                            <strong>82</strong>/100
                        </div>

                    </div>


                    <small>
                        Demonstração visual. As análises são auxiliares
                        e não representam recomendação de investimento
                        ou garantia de resultado.
                    </small>

                </div>

            </div>

        </div>

    </div>

</section>