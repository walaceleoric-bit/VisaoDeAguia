@model VisaoDeAguia.Models.ResultadoAnalise

@{
    ViewData["Title"] = "Analisar";

    var classeDirecao = Model.Direcao switch
    {
        "COMPRAR" => "text-success",
        "VENDER" => "text-danger",
        _ => "text-warning"
    };

    var classeForca = Model.Forca switch
    {
        "FORTE" => "text-success",
        "MODERADO" => "text-warning",
        _ => "text-secondary"
    };

    string FormatarPreco(decimal valor)
    {
        return valor.ToString("0.########");
    }

    string ClasseSituacao(string situacao)
    {
        return situacao switch
        {
            "Compra" => "text-success",
            "Venda" => "text-danger",
            _ => "text-warning"
        };
    }

    string TextoConfirmacao(
        bool compra,
        bool venda)
    {
        if (compra)
            return "COMPRA";

        if (venda)
            return "VENDA";

        return "NEUTRO";
    }

    string ClasseConfirmacao(
        bool compra,
        bool venda)
    {
        if (compra)
            return "text-success";

        if (venda)
            return "text-danger";

        return "text-warning";
    }
}

<div class="container py-5">

    <div class="mb-4">

        <span class="secao-label">
            ANÁLISE INTELIGENTE
        </span>

        <h1 class="mt-2">
            Analisar Mercado
        </h1>

        <p class="text-secondary">
            Análise multi-timeframe com tendência,
            pullback, gatilho, médias móveis,
            Bollinger, RSI e MACD.
        </p>

    </div>

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger">
            <strong>Erro ao analisar mercado:</strong>
            @ViewBag.Erro
        </div>
    }
    else
    {
        <!-- RESULTADO PRINCIPAL -->

        <div class="painel-analise mb-4">

            <div class="painel-topo">

                <span>
                    @Model.Simbolo
                </span>

                <span class="online">
                    ● ANÁLISE CONCLUÍDA
                </span>

            </div>

            <div class="text-center py-4">

                <div class="text-secondary mb-2">
                    RESULTADO DA ANÁLISE
                </div>

                <h2 class="@classeDirecao fw-bold display-5">
                    @Model.Direcao
                </h2>

                <div class="mt-3">

                    <span class="text-secondary">
                        FORÇA DO CENÁRIO
                    </span>

                    <h3 class="@classeForca fw-bold mt-1">
                        @Model.Forca
                    </h3>

                </div>

            </div>

            <div class="score-exemplo">

                <span>
                    PONTUAÇÃO
                </span>

                <div>
                    <strong>@Model.Pontuacao</strong>/100
                </div>

            </div>

            <div class="analise-linha">

                <span>
                    Preço atual
                </span>

                <strong>
                    @FormatarPreco(Model.PrecoAtual)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Horário da última vela
                </span>

                <strong>
                    @Model.DataHora.ToString("dd/MM/yyyy HH:mm")
                </strong>

            </div>

        </div>


        <!-- MULTI-TIMEFRAME -->

        <div class="painel-analise mb-4">

            <div class="painel-topo">

                <span>
                    ANÁLISE MULTI-TIMEFRAME
                </span>

                <span>
                    2H → 1H → 30M → 15M → 5M
                </span>

            </div>

            <div class="analise-linha">

                <span>
                    Tendência 2H
                </span>

                <strong>
                    @Model.Tendencia2H
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Tendência 1H
                </span>

                <strong>
                    @Model.Tendencia1H
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Estrutura 30M
                </span>

                <strong>
                    @Model.Estrutura30M
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Pullback 15M
                </span>

                <strong>
                    @Model.Pullback15M
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Confirmação 5M
                </span>

                <strong>
                    @Model.Confirmacao5M
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Alinhamento das tendências
                </span>

                <strong class="@(Model.TendenciasAlinhadas ? "text-success" : "text-warning")">

                    @(Model.TendenciasAlinhadas
                        ? "ALINHADAS"
                        : "NÃO ALINHADAS")

                </strong>

            </div>

        </div>


        <!-- MÉDIAS 10 / 50 / 200 -->

        <div class="painel-analise mb-4">

            <div class="painel-topo">

                <span>
                    MÉDIAS MÓVEIS
                </span>

                <span>
                    EMA 10 / 50 / 200
                </span>

            </div>

            <div class="analise-linha">

                <span>
                    Confirmação das médias
                </span>

                <strong class="@ClasseConfirmacao(
                    Model.MediasConfirmamCompra,
                    Model.MediasConfirmamVenda)">

                    @TextoConfirmacao(
                        Model.MediasConfirmamCompra,
                        Model.MediasConfirmamVenda)

                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    2H
                </span>

                <strong>
                    10: @FormatarPreco(Model.Media10_2H)
                    |
                    50: @FormatarPreco(Model.Media50_2H)
                    |
                    200: @FormatarPreco(Model.Media200_2H)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    1H
                </span>

                <strong>
                    10: @FormatarPreco(Model.Media10_1H)
                    |
                    50: @FormatarPreco(Model.Media50_1H)
                    |
                    200: @FormatarPreco(Model.Media200_1H)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    30M
                </span>

                <strong>
                    10: @FormatarPreco(Model.Media10_30M)
                    |
                    50: @FormatarPreco(Model.Media50_30M)
                    |
                    200: @FormatarPreco(Model.Media200_30M)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    15M
                </span>

                <strong>
                    10: @FormatarPreco(Model.Media10_15M)
                    |
                    50: @FormatarPreco(Model.Media50_15M)
                    |
                    200: @FormatarPreco(Model.Media200_15M)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    5M
                </span>

                <strong>
                    10: @FormatarPreco(Model.Media10_5M)
                    |
                    50: @FormatarPreco(Model.Media50_5M)
                    |
                    200: @FormatarPreco(Model.Media200_5M)
                </strong>

            </div>

        </div>


        <!-- RSI -->

        <div class="painel-analise mb-4">

            <div class="painel-topo">

                <span>
                    RSI
                </span>

                <span>
                    RSI 14
                </span>

            </div>

            <div class="analise-linha">

                <span>
                    RSI 5M
                </span>

                <strong>
                    @Model.Rsi14_5M.ToString("0.00")
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    RSI 15M
                </span>

                <strong>
                    @Model.Rsi14_15M.ToString("0.00")
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Leitura
                </span>

                <strong class="@ClasseSituacao(Model.SituacaoRsi)">
                    @Model.SituacaoRsi.ToUpper()
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Confirmação
                </span>

                <strong class="@ClasseConfirmacao(
                    Model.RsiConfirmaCompra,
                    Model.RsiConfirmaVenda)">

                    @TextoConfirmacao(
                        Model.RsiConfirmaCompra,
                        Model.RsiConfirmaVenda)

                </strong>

            </div>

        </div>


        <!-- MACD -->

        <div class="painel-analise mb-4">

            <div class="painel-topo">

                <span>
                    MACD
                </span>

                <span>
                    12 / 26 / 9
                </span>

            </div>

            <div class="analise-linha">

                <span>
                    Linha MACD
                </span>

                <strong>
                    @Model.Macd5M.ToString("0.########")
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Linha de sinal
                </span>

                <strong>
                    @Model.MacdSinal5M.ToString("0.########")
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Histograma
                </span>

                <strong>
                    @Model.MacdHistograma5M.ToString("0.########")
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Leitura
                </span>

                <strong class="@ClasseSituacao(Model.SituacaoMacd)">
                    @Model.SituacaoMacd.ToUpper()
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Confirmação
                </span>

                <strong class="@ClasseConfirmacao(
                    Model.MacdConfirmaCompra,
                    Model.MacdConfirmaVenda)">

                    @TextoConfirmacao(
                        Model.MacdConfirmaCompra,
                        Model.MacdConfirmaVenda)

                </strong>

            </div>

        </div>


        <!-- BOLLINGER -->

        <div class="painel-analise mb-4">

            <div class="painel-topo">

                <span>
                    BANDAS DE BOLLINGER
                </span>

                <span>
                    20 / 2
                </span>

            </div>

            <div class="analise-linha">

                <span>
                    Banda superior
                </span>

                <strong>
                    @FormatarPreco(Model.BollingerSuperior5M)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Média
                </span>

                <strong>
                    @FormatarPreco(Model.BollingerMedia5M)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Banda inferior
                </span>

                <strong>
                    @FormatarPreco(Model.BollingerInferior5M)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Leitura
                </span>

                <strong class="@ClasseSituacao(Model.SituacaoBollinger5M)">
                    @Model.SituacaoBollinger5M.ToUpper()
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Confirmação
                </span>

                <strong class="@ClasseConfirmacao(
                    Model.BollingerConfirmaCompra,
                    Model.BollingerConfirmaVenda)">

                    @TextoConfirmacao(
                        Model.BollingerConfirmaCompra,
                        Model.BollingerConfirmaVenda)

                </strong>

            </div>

        </div>


        <!-- SUPORTE E RESISTÊNCIA -->

        <div class="painel-analise mb-4">

            <div class="painel-topo">

                <span>
                    REGIÕES IMPORTANTES
                </span>

                <span>
                    SUPORTE / RESISTÊNCIA
                </span>

            </div>

            <div class="analise-linha">

                <span>
                    Suporte
                </span>

                <strong>
                    @FormatarPreco(Model.Suporte)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Resistência
                </span>

                <strong>
                    @FormatarPreco(Model.Resistencia)
                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Preço próximo do suporte
                </span>

                <strong class="@(Model.ProximoSuporte ? "text-success" : "text-secondary")">

                    @(Model.ProximoSuporte
                        ? "SIM"
                        : "NÃO")

                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Preço próximo da resistência
                </span>

                <strong class="@(Model.ProximoResistencia ? "text-success" : "text-secondary")">

                    @(Model.ProximoResistencia
                        ? "SIM"
                        : "NÃO")

                </strong>

            </div>

        </div>


        <!-- CONFIRMAÇÕES OBRIGATÓRIAS -->

        <div class="painel-analise mb-4">

            <div class="painel-topo">

                <span>
                    CONFIRMAÇÕES DE ENTRADA
                </span>

                <span>
                    PULLBACK 15M / GATILHO 5M
                </span>

            </div>

            <div class="analise-linha">

                <span>
                    Pullback 15M confirmado
                </span>

                <strong class="@(Model.PullbackConfirmado ? "text-success" : "text-warning")">

                    @(Model.PullbackConfirmado
                        ? "SIM"
                        : "NÃO")

                </strong>

            </div>

            <div class="analise-linha">

                <span>
                    Gatilho 5M confirmado
                </span>

                <strong class="@(Model.GatilhoConfirmado ? "text-success" : "text-warning")">

                    @(Model.GatilhoConfirmado
                        ? "SIM"
                        : "NÃO")

                </strong>

            </div>

            @if (!Model.PullbackConfirmado ||
                 !Model.GatilhoConfirmado)
            {
                <div class="mt-3">

                    <small class="text-warning">
                        O cenário ainda não possui todas as
                        confirmações obrigatórias para uma entrada.
                    </small>

                </div>
            }

        </div>


        <!-- CRITÉRIOS -->

        <div class="painel-analise">

            <div class="painel-topo">

                <span>
                    CRITÉRIOS ANALISADOS
                </span>

                <span>
                    VISÃO DE ÁGUIA
                </span>

            </div>

            @if (Model.Motivos != null &&
                 Model.Motivos.Count > 0)
            {
                @foreach (var motivo in Model.Motivos)
                {
                    <div class="analise-linha">

                        <span>
                            @motivo
                        </span>

                        <strong>
                            ✓
                        </strong>

                    </div>
                }
            }
            else
            {
                <div class="analise-linha">

                    <span>
                        Nenhum critério adicional registrado.
                    </span>

                    <strong>
                        —
                    </strong>

                </div>
            }

            <div class="mt-4">

                <small class="text-secondary">
                    Esta análise é uma ferramenta de apoio
                    e não representa garantia de resultado
                    ou recomendação de investimento.
                </small>

            </div>

        </div>
    }

</div>